{
  "name": "@edgegap/sdk",
  "version": "0.1.0",
  "description": "Edgegap Matchmaking and Server Browser SDK for browser games and their Node, Bun, or Deno game servers.",
  "license": "MIT",
  "author": {
    "name": "Edgegap Technologies",
    "email": "contact@edgegap.com",
    "url": "https://www.edgegap.com"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./matchmaking": {
      "import": {
        "types": "./dist/matchmaking/index.d.ts",
        "default": "./dist/matchmaking/index.js"
      },
      "require": {
        "types": "./dist/matchmaking/index.d.cts",
        "default": "./dist/matchmaking/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run test/integration"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsdown": "^0.23.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
